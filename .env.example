SECRET_KEY = 'your-secret-key-here'
DEBUG_MODE=True

# Database
DB_ENGINE = sqlite

# Yandex Maps
YANDEX_MAPS_API_KEY = 'your-yandex-maps-api-key-here'

# SMTP Email Settings
EMAIL_BACKEND = django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST = smtp.yandex.ru
EMAIL_PORT = 587
EMAIL_USE_TLS = True
EMAIL_HOST_USER = 'your-email@yandex.ru'
EMAIL_HOST_PASSWORD = 'your-smtp-password'
DEFAULT_FROM_EMAIL = 'your-email@yandex.ru'

# YooKassa
YOOKASSA_SHOP_ID = 'your-shop-id'
YOOKASSA_SECRET_KEY = 'your-secret-key'
YOOKASSA_WEBHOOK_KEY = 'your-webhook-key'
YOOKASSA_WEBHOOK_URL = 'https://yourdomain.com/api/yookassa/webhook/'

# Yandex Cloud Object Storage
USE_YANDEX_CLOUD='False'
YANDEX_CLOUD_ACCESS_KEY_ID = 'your-access-key'
YANDEX_CLOUD_SECRET_ACCESS_KEY = 'your-secret-key'
YANDEX_CLOUD_BUCKET_NAME = 'your-bucket-name'
YANDEX_CLOUD_ENDPOINT_URL = 'https://storage.yandexcloud.net'